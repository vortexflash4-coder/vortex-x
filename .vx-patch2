+++ b/app/src/main/java/com/vortexx/player/audio/dsp/Biquad.kt
@@ -58,0 +59,57 @@
+    /** Low shelf (slope 1): [gainDb] well below [cornerHz], half of it at the corner, 0 dB well above. */
+    fun setLowShelf(sampleRate: Int, cornerHz: Double, gainDb: Double) {
+        if (gainDb == 0.0) {
+            setIdentity()
+            return
+        }
+        val a = 10.0.pow(gainDb / 40.0)
+        val w0 = 2.0 * PI * cornerHz / sampleRate
+        val cosW0 = cos(w0)
+        val beta = 2.0 * sqrt(a) * (sin(w0) / 2.0 * sqrt(2.0))
+        val a0 = (a + 1.0) + (a - 1.0) * cosW0 + beta
+        b0 = a * ((a + 1.0) - (a - 1.0) * cosW0 + beta) / a0
+        b1 = 2.0 * a * ((a - 1.0) - (a + 1.0) * cosW0) / a0
+        b2 = a * ((a + 1.0) - (a - 1.0) * cosW0 - beta) / a0
+        a1 = -2.0 * ((a - 1.0) + (a + 1.0) * cosW0) / a0
+        a2 = ((a + 1.0) + (a - 1.0) * cosW0 - beta) / a0
+    }
+
+    /** Second-order low-pass; [q] = 0.7071 gives a Butterworth response. */
+    fun setLowPass(sampleRate: Int, cornerHz: Double, q: Double) {
+        val w0 = 2.0 * PI * cornerHz / sampleRate
+        val alpha = sin(w0) / (2.0 * q)
+        val cosW0 = cos(w0)
+        val a0 = 1.0 + alpha
+        b0 = (1.0 - cosW0) / 2.0 / a0
+        b1 = (1.0 - cosW0) / a0
+        b2 = (1.0 - cosW0) / 2.0 / a0
+        a1 = (-2.0 * cosW0) / a0
+        a2 = (1.0 - alpha) / a0
+    }
+
+    /** Second-order high-pass; [q] = 0.7071 gives a Butterworth response. */
+    fun setHighPass(sampleRate: Int, cornerHz: Double, q: Double) {
+        val w0 = 2.0 * PI * cornerHz / sampleRate
+        val alpha = sin(w0) / (2.0 * q)
+        val cosW0 = cos(w0)
+        val a0 = 1.0 + alpha
+        b0 = (1.0 + cosW0) / 2.0 / a0
+        b1 = -(1.0 + cosW0) / a0
+        b2 = (1.0 + cosW0) / 2.0 / a0
+        a1 = (-2.0 * cosW0) / a0
+        a2 = (1.0 - alpha) / a0
+    }
+
+    /** Second-order all-pass: changes phase only, as a low-pass plus high-pass crossover pair does. */
+    fun setAllPass(sampleRate: Int, cornerHz: Double, q: Double) {
+        val w0 = 2.0 * PI * cornerHz / sampleRate
+        val alpha = sin(w0) / (2.0 * q)
+        val cosW0 = cos(w0)
+        val a0 = 1.0 + alpha
+        b0 = (1.0 - alpha) / a0
+        b1 = (-2.0 * cosW0) / a0
+        b2 = 1.0
+        a1 = (-2.0 * cosW0) / a0
+        a2 = (1.0 - alpha) / a0
+    }
+
