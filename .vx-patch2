+    }
+
+    private fun write(output: ByteBuffer, samples: Int, isFloat: Boolean) {
+        val buffer = work
+        if (isFloat) {
+            // Sample ceiling: never hand the output more than full scale. Overs are already counted.
+            for (i in 0 until samples) {
+                val x = buffer[i]
+                output.putFloat(if (x > 1f) 1f else if (x < -1f) -1f else x)
+            }
+        } else {
+            for (i in 0 until samples) {
+                val value = Math.round(buffer[i] * FLOAT_TO_INT16)
+                val clamped = if (value > Short.MAX_VALUE) Short.MAX_VALUE.toInt() else if (value < Short.MIN_VALUE) Short.MIN_VALUE.toInt() else value
+                output.putShort(clamped.toShort())
+            }
+        }
+    }
+
+    /**
+     * The limiter delays the signal by its look-ahead, so at the end of the
+     * stream it still holds that much audio. Media3 asks for output only when
+     * the previous output buffer has been used up, so the rest is produced
+     * here, not in [onQueueEndOfStream], where it could overwrite a buffer that
+     * is still being played.
+     */
+    override fun onQueueEndOfStream() {
+        tailPending = activeChannels > 0 && chain.latencyFrames > 0
+    }
+
+    override fun getOutput(): ByteBuffer {
+        if (tailPending && super.isEnded()) {
+            tailPending = false
+            writeTail()
+        }
+        return super.getOutput()
+    }
+
+    override fun isEnded(): Boolean = !tailPending && super.isEnded()
+
+    private fun writeTail() {
+        val channels = activeChannels
+        val frames = chain.latencyFrames
+        if (channels == 0 || frames == 0) return
+        val isFloat = activeEncoding == C.ENCODING_PCM_FLOAT
+        val output = replaceOutputBuffer(frames * channels * (if (isFloat) 4 else 2))
+        val now = System.nanoTime()
+        var done = 0
+        while (done < frames) {
+            val chunk = minOf(CHUNK_FRAMES, frames - done)
+            val samples = chunk * channels
+            java.util.Arrays.fill(work, 0, samples, 0f)
+            chain.process(work, chunk, now)
+            write(output, samples, isFloat)
+            done += chunk
+        }
+        output.flip()
+        // Everything that was taken in has now been handed on.
+        if (streamOffsetUs != C.TIME_UNSET) {
+            host.onProcessedPosition(streamOffsetUs + framesSinceFlush * 1_000_000L / activeSampleRate)
+        }
