+    /** Saves the current sound under [name]. False when the name is empty or belongs to a built-in preset. */
+    fun saveUserPreset(name: String): Boolean {
+        val clean = SoundPresets.cleanName(name)
+        if (!SoundPresets.isUsableName(clean)) return false
+        storeUserPresets(SoundPresets.withSaved(_userPresets.value, clean, userParameters))
+        return true
+    }
+
+    fun deleteUserPreset(name: String) = storeUserPresets(_userPresets.value.filterNot { it.name == name })
