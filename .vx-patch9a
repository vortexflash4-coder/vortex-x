+/** The phone's own library, summarised. Opens the music library; counts come from the media scan. */
+@Composable
+private fun LibraryCard(songs: Int, videos: Int, onOpen: () -> Unit, modifier: Modifier = Modifier) {
+    val shape = RoundedCornerShape(20.dp)
+    Row(
+        modifier
+            .fillMaxWidth()
+            .clip(shape)
+            .background(VortexColors.Card)
+            .border(1.dp, VortexColors.Divider, shape)
+            .clickable(role = Role.Button, onClickLabel = "Open library", onClick = onOpen)
+            .padding(VortexSpacing.lg),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Icon(Icons.Rounded.Folder, contentDescription = null, tint = VortexColors.TextSecondary, modifier = Modifier.size(28.dp))
+        Spacer(Modifier.width(VortexSpacing.md))
+        Column(Modifier.weight(1f)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text("On this device", style = MaterialTheme.typography.titleMedium)
+                Spacer(Modifier.width(VortexSpacing.sm))
+                MetaChip("LOCAL")
+            }
+            Text(
+                "${LibraryLogic.pluralize(songs, "song")} · ${LibraryLogic.pluralize(videos, "video")}",
+                style = MaterialTheme.typography.bodyMedium,
+                color = VortexColors.TextSecondary,
+            )
+        }
+        Icon(Icons.Rounded.ChevronRight, contentDescription = null, tint = VortexColors.TextSecondary)
+    }
+}
