diff --git a/app/src/main/java/com/vortexx/player/feature/diagnostics/DiagnosticsScreen.kt b/app/src/main/java/com/vortexx/player/feature/diagnostics/DiagnosticsScreen.kt
index 14ec42b..c32c9f9 100644
--- a/app/src/main/java/com/vortexx/player/feature/diagnostics/DiagnosticsScreen.kt
+++ b/app/src/main/java/com/vortexx/player/feature/diagnostics/DiagnosticsScreen.kt
@@ -72,14 +72,14 @@ data class DiagnosticsReport(
     val duplicateGroups: Int?,
     val decoderPack: DecoderPack.Status? = null,
 ) {
-    /** Honest one-line verdict about object-based (Atmos-family) audio on this device. */
+    /** Honest one-line verdict about object-based audio (E-AC-3 JOC, AC-4) on this device. */
     val immersiveVerdict: String
         get() {
             val joc = immersive.firstOrNull { it.mime == "audio/eac3-joc" }?.supported == true
             val ac4 = immersive.firstOrNull { it.mime == "audio/ac4" }?.supported == true
-            val passthrough = outputs.any { o -> o.encodings.any { it == "E-AC-3 JOC" || it == "Dolby TrueHD" || it == "Dolby MAT" } }
+            val passthrough = outputs.any { o -> o.encodings.any { it == "E-AC-3 JOC" || it == "TrueHD" || it == "MAT" } }
             return when {
-                joc || ac4 -> "This device has a decoder for object-based Dolby-family audio. Native immersive playback still depends on the content and the output device."
+                joc || ac4 -> "This device has a decoder for object-based audio (E-AC-3 JOC or AC-4). Native immersive playback still depends on the content and the output device."
                 passthrough -> "No on-device object-audio decoder, but the current output accepts encoded object audio (passthrough)."
                 else -> "No object-based audio decoder or passthrough output detected. Immersive tracks fall back to their stereo or multichannel bed."
             }
