<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="vortex.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="vortex.db" />
    </device-transfer>
</data-extraction-rules>
