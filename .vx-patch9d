+            // The write takes whatever the list is when it runs, so two quick edits can never
+            // leave the older list on disk.
+            scope.launch { dataStore.edit { it[KEY_USER_PRESETS] = SoundPresets.encodeUser(_userPresets.value) } }
+        }
+        return edit.result
