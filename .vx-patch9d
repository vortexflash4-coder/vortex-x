@@ -3,6 +3,27 @@ package com.vortexx.player.audio.dsp
 /** A named set of Audio Lab settings. [builtIn] presets ship with the app; the others are the user's. */
 data class SoundPreset(val name: String, val parameters: DspParameters, val builtIn: Boolean)
 
+/** What a save, rename or delete of a user preset did, or why it did nothing. [done] is true when the list changed as asked. */
+enum class PresetResult(val done: Boolean) {
+    Saved(true),
+    Overwritten(true),
+    Renamed(true),
+    Deleted(true),
+
+    /** Another preset of the user already has that name. */
+    NameTaken(false),
+
+    /** Empty, or the name of a built-in preset. */
+    BadName(false),
+
+    /** All [SoundPresets.MAX_USER_PRESETS] places are used and the name is a new one. */
+    Full(false),
+    NotFound(false),
+}
+
+/** The user's presets after an edit, with what happened. When nothing changed, [presets] is the list that was passed in. */
+data class PresetEdit(val presets: List<SoundPreset>, val result: PresetResult)
+
 /**
  * The presets that ship with the app, and the storage format of the user's own.
  * A preset sets the sound (preamp, EQ, bass, compressor, limiter, width). It
@@ -59,11 +80,65 @@ object SoundPresets {
     fun isUsableName(name: String): Boolean =
         name.isNotEmpty() && BUILT_IN.none { it.name.equals(name, ignoreCase = true) }
 
-    /** [presets] with [name] set to [parameters]: replaces a preset of that name, else adds it; the oldest goes when full. */
-    fun withSaved(presets: List<SoundPreset>, name: String, parameters: DspParameters): List<SoundPreset> {
-        val saved = SoundPreset(name, parameters.copy(enabled = true, speakerProtect = false), builtIn = false)
-        val others = presets.filterNot { it.name.equals(name, ignoreCase = true) }
-        return (others + saved).takeLast(MAX_USER_PRESETS)
+    private fun indexOfName(presets: List<SoundPreset>, name: String): Int =
+        presets.indexOfFirst { it.name.equals(name, ignoreCase = true) }
+
+    /**
+     * What saving [rawName] would do: [PresetResult.Overwritten] when a preset has that name (it keeps its
+     * place and its spelling), [PresetResult.Saved] when there is room, [PresetResult.Full] when all
+     * [MAX_USER_PRESETS] places are used, [PresetResult.BadName] when the name cannot be used.
+     * A preset is never deleted to make room.
+     */
+    fun saveOutcome(presets: List<SoundPreset>, rawName: String): PresetResult {
+        val name = cleanName(rawName)
+        if (!isUsableName(name)) return PresetResult.BadName
+        if (indexOfName(presets, name) >= 0) return PresetResult.Overwritten
+        return if (presets.size >= MAX_USER_PRESETS) PresetResult.Full else PresetResult.Saved
+    }
+
+    /** Saves [parameters] (without the two device switches) under [rawName]; see [saveOutcome]. */
+    fun save(presets: List<SoundPreset>, rawName: String, parameters: DspParameters): PresetEdit {
+        val result = saveOutcome(presets, rawName)
+        if (!result.done) return PresetEdit(presets, result)
+        val name = cleanName(rawName)
+        val sound = parameters.copy(enabled = true, speakerProtect = false)
+        val index = indexOfName(presets, name)
+        val edited = if (index >= 0) {
+            presets.mapIndexed { i, p -> if (i == index) SoundPreset(p.name, sound, builtIn = false) else p }
+        } else {
+            presets + SoundPreset(name, sound, builtIn = false)
+        }
+        return PresetEdit(edited, result)
+    }
+
+    /** [presets] with [name] set to [parameters]: replaces a preset of that name, else adds it while there is room. */
+    fun withSaved(presets: List<SoundPreset>, name: String, parameters: DspParameters): List<SoundPreset> =
+        save(presets, name, parameters).presets
+
+    /** What renaming [oldName] to [rawNew] would do. A change of letter case alone is allowed. */
+    fun renameOutcome(presets: List<SoundPreset>, oldName: String, rawNew: String): PresetResult {
+        val from = indexOfName(presets, oldName)
+        if (from < 0) return PresetResult.NotFound
+        val name = cleanName(rawNew)
+        if (!isUsableName(name)) return PresetResult.BadName
+        val other = indexOfName(presets, name)
+        return if (other >= 0 && other != from) PresetResult.NameTaken else PresetResult.Renamed
+    }
+
+    /** Gives the preset [oldName] the name [rawNew], keeping its place and its sound. */
+    fun rename(presets: List<SoundPreset>, oldName: String, rawNew: String): PresetEdit {
+        val result = renameOutcome(presets, oldName, rawNew)
+        if (!result.done) return PresetEdit(presets, result)
+        val from = indexOfName(presets, oldName)
+        val name = cleanName(rawNew)
+        return PresetEdit(presets.mapIndexed { i, p -> if (i == from) p.copy(name = name) else p }, result)
+    }
+
+    /** Removes the preset called [name]. */
+    fun delete(presets: List<SoundPreset>, name: String): PresetEdit {
+        val index = indexOfName(presets, name)
+        if (index < 0) return PresetEdit(presets, PresetResult.NotFound)
+        return PresetEdit(presets.filterIndexed { i, _ -> i != index }, PresetResult.Deleted)
     }
 
     /** One preset per line: name, a tab, the encoded settings. */
