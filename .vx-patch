--- a/.github/scripts/ci-publish.sh
+++ b/.github/scripts/ci-publish.sh
@@ -44 +44,2 @@
-ASSET="$(api -X POST -H "Content-Type: application/vnd.android.package-archive" --data-binary @"$APK" "$UPLOAD?name=$NAME")"
+# --upload-file streams the APK; --data-binary would first read all of it into memory.
+ASSET="$(api -X POST -H "Content-Type: application/vnd.android.package-archive" --upload-file "$APK" "$UPLOAD?name=$NAME")"
@@ -54,0 +56,5 @@
+# A large APK is delivered by this release only: as an Actions artifact it would use up the
+# repository's artifact storage. ("assemble" is what the workflow's artifact step looks at.)
+if [ -n "${GITHUB_OUTPUT:-}" ] && [ "$(wc -c < "$APK")" -gt 104857600 ]; then
+  echo "assemble=published" >> "$GITHUB_OUTPUT"
+fi
--- a/.github/scripts/ci-smoke.sh
+++ b/.github/scripts/ci-smoke.sh
@@ -20,0 +21,4 @@
+if [ -f "${GITHUB_WORKSPACE:-.}/.vx-nosmoke" ]; then
+  say "Skipped: switched off for this build (.vx-nosmoke)."
+  exit 2
+fi
@@ -35 +39,5 @@
-IMAGE="system-images;android-34;default;x86_64"
+# avdmanager and the emulator look in different default folders on CI; give both the same one.
+export ANDROID_AVD_HOME="$HOME/.android/avd"
+mkdir -p "$ANDROID_AVD_HOME"
+# Google APIs image: it can run the app's ARM native libraries by translation (the APK has no x86 ones).
+IMAGE="system-images;android-34;google_apis;x86_64"
--- a/.github/scripts/ci-summary.sh
+++ b/.github/scripts/ci-summary.sh
@@ -26 +26,4 @@
-outcome = {k: (os.environ.get(k) or "skipped") for k in ("FONTS", "FFMPEG", "ASSEMBLE", "UNIT", "ANDROIDTEST", "LINT", "SMOKE")}
+outcome = {k: (os.environ.get(k) or "skipped") for k in ("FONTS", "MODELS", "FFMPEG", "ASSEMBLE", "UNIT", "ANDROIDTEST", "LINT", "SMOKE")}
+# An older build script does not report the models step; the list it leaves behind does.
+if outcome["MODELS"] == "skipped" and os.path.exists(os.path.join(project, "app/build/ai-test/models.txt")):
+    outcome["MODELS"] = "success"
@@ -42,0 +46 @@
+    ("MODELS", "AI models download (`ci-models.sh`; a failure builds without AI)"),
@@ -52,0 +57,7 @@
+models = os.path.join(project, "app/build/ai-test/models.txt")
+if os.path.exists(models):
+    rows = [l.split() for l in open(models) if l.strip()]
+    parts = [f"{r[0]} {int(r[1]) / 1048576:.1f} MB" for r in rows if len(r) >= 2 and r[0] != "total"]
+    total = next((int(r[1]) for r in rows if r[0] == "total"), 0)
+    w(f"AI models packaged in the APK: {', '.join(parts)}; total {total / 1048576:.1f} MB.")
+    w("")
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -21,2 +21,2 @@
-        versionCode = 6
-        versionName = "0.4.0-m2"
+        versionCode = 7
+        versionName = "0.5.0-ai"
@@ -24,0 +25,8 @@
+        // Phones only. Emulator-only ABIs (x86, x86_64) would add about 25 MB of native
+        // libraries (ONNX Runtime, FFmpeg) that no phone uses.
+        ndk { abiFilters += listOf("arm64-v8a", "armeabi-v7a") }
+    }
+
+    androidResources {
+        // The AI models are memory-mapped straight from the APK, which needs them stored as-is.
+        noCompress += listOf("onnx")
@@ -133,0 +142,4 @@
+    // On-device AI (karaoke and lyrics): ONNX Runtime. The desktop build of the same version
+    // lets the JVM unit tests run the real models on the CI machine.
+    implementation(libs.onnxruntime.android)
+    testImplementation(libs.onnxruntime.jvm)
