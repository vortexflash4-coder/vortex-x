+    val aiChanges: StateFlow<Int> = aiStore.changes
+
+    /** AI-written lyrics for what is playing (the song or its karaoke track); empty when there are none. */
+    fun lyrics(nowPlaying: NowPlaying): List<LyricLine> =
+        AiStore.keyFor(nowPlaying.songId, nowPlaying.contentUri)?.let { aiStore.readLyrics(it) } ?: emptyList()
+
@@ -179,0 +193 @@
