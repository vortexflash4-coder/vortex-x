@@ -247,0 +262 @@
+                    onOpenAiStudio = onOpenAiStudio,
@@ -362,0 +378 @@
+    onOpenAiStudio: () -> Unit,
@@ -430,0 +447,7 @@
+        val aiChanges by viewModel.aiChanges.collectAsStateWithLifecycle()
+        val lyricLines = remember(nowPlaying.mediaId, aiChanges) { viewModel.lyrics(nowPlaying) }
+        if (lyricLines.isNotEmpty()) {
+            Spacer(Modifier.height(VortexSpacing.lg))
+            LyricsStrip(lines = lyricLines, positionMs = position.positionMs, onClick = onOpenAiStudio)
+        }
+
@@ -443,0 +467 @@
+            ActionItem(Icons.Rounded.AutoAwesome, "AI", lyricLines.isNotEmpty(), onOpenAiStudio, Modifier.weight(1f))
@@ -583,0 +608,34 @@
+    }
+}
+
+/** The lyric line being sung and the one after it (AI-written lyrics, when the song has them). */
+@Composable
+private fun LyricsStrip(lines: List<LyricLine>, positionMs: Long, onClick: () -> Unit) {
+    val index = Lrc.indexAt(lines, positionMs)
+    val shape = RoundedCornerShape(16.dp)
+    Column(
+        Modifier
+            .fillMaxWidth()
+            .clip(shape)
+            .background(VortexColors.Card)
+            .border(1.dp, VortexColors.Divider, shape)
+            .clickable(role = Role.Button, onClickLabel = "Open AI Studio", onClick = onClick)
+            .padding(horizontal = VortexSpacing.md, vertical = VortexSpacing.sm),
+    ) {
+        Text("LYRICS · WRITTEN BY AI", style = InstrumentText.label.copy(color = VortexColors.Accent))
+        Text(
+            if (index >= 0) lines[index].text else "…",
+            style = MaterialTheme.typography.titleMedium,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+        )
+        val following = lines.getOrNull(index + 1)
+        if (following != null) {
+            Text(
+                following.text,
+                style = MaterialTheme.typography.bodySmall,
+                color = VortexColors.TextSecondary,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
