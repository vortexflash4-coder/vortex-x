     val studio: StudioMeters? get() = null
 
+    /** The Jhankar engine's setting for the current output (a volatile read). The default is the engine switched off. */
+    val jhankar: JhankarParameters get() = JhankarParameters.OFF
+
+    /** Where the Jhankar engine reports its bass boost, punch and compression; null = not shown anywhere. */
+    val jhankarMeters: JhankarMeters? get() = null
+
+    /** Where the finished output is copied for the spectrum analyzer; null = no analyzer. */
+    val spectrum: SpectrumBus? get() = null
+
