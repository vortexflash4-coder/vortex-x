+/**
+ * Video picture size. The enum names are stored in settings, so they keep their old names;
+ * the labels are what people see. Original letterboxes, Fill stretches to the screen and
+ * Zoom crops to fill. 16:9 and 2.35:1 force a frame of that shape and crop the picture to it.
+ */
+enum class VideoScaling(val label: String, val forcedAspect: Float? = null) {
+    Fit("Original"),
+    Stretch("Fill"),
+    Crop("Zoom"),
+    Wide169("16:9", 16f / 9f),
+    Cinema235("2.35:1", 2.35f),
 }
 
 data class AppSettings(
