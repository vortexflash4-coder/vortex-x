     VideoScaling.Stretch -> AspectRatioFrameLayout.RESIZE_MODE_FILL
-    VideoScaling.Crop -> AspectRatioFrameLayout.RESIZE_MODE_ZOOM
+    VideoScaling.Crop, VideoScaling.Wide169, VideoScaling.Cinema235 -> AspectRatioFrameLayout.RESIZE_MODE_ZOOM
 }
diff --git a/app/src/test/java/com/vortexx/player/VideoScalingTest.kt b/app/src/test/java/com/vortexx/player/VideoScalingTest.kt
new file mode 100644
index 0000000..4220f8d
--- /dev/null
+++ b/app/src/test/java/com/vortexx/player/VideoScalingTest.kt
@@ -0,0 +1,32 @@
+package com.vortexx.player
+
+import com.vortexx.player.data.settings.VideoScaling
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.math.abs
+
+class VideoScalingTest {
+
+    @Test
+    fun fiveSizesInTheOrderPeopleSee() {
+        assertEquals(listOf("Original", "Fill", "Zoom", "16:9", "2.35:1"), VideoScaling.entries.map { it.label })
+    }
+
+    @Test
+    fun onlyTheTwoCinemaShapesForceAnAspect() {
+        assertNull(VideoScaling.Fit.forcedAspect)
+        assertNull(VideoScaling.Stretch.forcedAspect)
+        assertNull(VideoScaling.Crop.forcedAspect)
+        assertTrue(abs(VideoScaling.Wide169.forcedAspect!! - 16f / 9f) < 0.0001f)
+        assertTrue(abs(VideoScaling.Cinema235.forcedAspect!! - 2.35f) < 0.0001f)
+    }
+
+    @Test
+    fun storedNamesStillResolve() {
+        // Settings are saved by enum name; the old names must keep working after the relabel.
+        assertEquals(VideoScaling.Crop, VideoScaling.valueOf("Crop"))
+        assertEquals(VideoScaling.Fit, VideoScaling.valueOf("Fit"))
+    }
+}
