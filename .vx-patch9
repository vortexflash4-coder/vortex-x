+/** A short on-screen readout for a gesture, such as "Volume 40%". */
+private data class GestureHud(val text: String, val stamp: Long = System.nanoTime())
+
+/** Keeps a value across the events of one drag (a local Float cannot change inside a lambda). */
+private class Carry(var value: Float = 0f)
+
+/**
+ * A strip along one screen edge. A vertical drag inside it calls [onDelta] with the drag as a
+ * fraction of the strip height (up is positive). [onStart] runs once when the drag begins.
+ */
+@Composable
+private fun SideGestureZone(
+    modifier: Modifier,
+    onStart: () -> Unit,
+    onDelta: (Float) -> Unit,
+) {
+    var heightPx by remember { mutableStateOf(1f) }
+    Box(
+        modifier
+            .onSizeChanged { heightPx = it.height.coerceAtLeast(1).toFloat() }
+            .pointerInput(Unit) {
+                detectVerticalDragGestures(
+                    onDragStart = { onStart() },
+                    onVerticalDrag = { change, dragAmount ->
+                        change.consume()
+                        onDelta(-dragAmount / heightPx)
+                    },
+                )
+            },
+    )
+}
+
+private fun Window.currentBrightness(context: Context): Float =
+    attributes.screenBrightness.takeIf { it >= 0f } ?: systemBrightness(context)
+
+/** The user's own brightness setting (0..255), used when this window has no override yet. */
+private fun systemBrightness(context: Context): Float =
+    try {
+        Settings.System.getInt(context.contentResolver, Settings.System.SCREEN_BRIGHTNESS) / 255f
+    } catch (e: Exception) {
+        0.5f
+    }
+
