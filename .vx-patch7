diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 1af0eab..d63b2a0 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -23,15 +23,10 @@ android {
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
         vectorDrawables { useSupportLibrary = true }
         // Phones only. Emulator-only ABIs (x86, x86_64) would add about 25 MB of native
-        // libraries (ONNX Runtime, FFmpeg) that no phone uses.
+        // libraries (FFmpeg) that no phone uses.
         ndk { abiFilters += listOf("arm64-v8a", "armeabi-v7a") }
     }
 
-    androidResources {
-        // The AI models are memory-mapped straight from the APK, which needs them stored as-is.
-        noCompress += listOf("onnx")
-    }
-
     signingConfigs {
         // Stable debug signing in CI without keeping a private key in the repository:
         // the workflow decodes the GitHub secret VORTEX_DEBUG_KEYSTORE_B64 to a temporary
@@ -139,10 +134,6 @@ dependencies {
     implementation(libs.kotlinx.coroutines.android)
     implementation(libs.kotlinx.serialization.json)
 
-    // On-device AI (karaoke and lyrics): ONNX Runtime. The desktop build of the same version
-    // lets the JVM unit tests run the real models on the CI machine.
-    implementation(libs.onnxruntime.android)
-    testImplementation(libs.onnxruntime.jvm)
     testImplementation(libs.junit)
     testImplementation(libs.kotlinx.coroutines.test)
 
