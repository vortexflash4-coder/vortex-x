     playbackEngine: PlaybackEngine,
     audioEngine: AudioEngine,
     diagnostics: AudioDiagnostics,
-    private val aiStore: AiStore,
 ) : ViewModel() {
-    /** Changes when AI lyrics are written or deleted. */
-    val aiChanges: StateFlow<Int> = aiStore.changes
-
-    /** AI-written lyrics for what is playing (the song or its karaoke track); empty when there are none. */
