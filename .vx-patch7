-        AiStore.keyFor(nowPlaying.songId, nowPlaying.contentUri)?.let { aiStore.readLyrics(it) } ?: emptyList()
-
     val state: StateFlow<PlaybackUiState> = playback.state
     val position: Flow<PositionSnapshot> = playback.positionUpdates(intervalMs = 250L)
     val status: StateFlow<DspStatus> = playbackEngine.status
