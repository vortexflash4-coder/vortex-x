-
-/** Videos up to this long are Shorts. */
-const val SHORTS_MAX_DURATION_MS = 3L * 60L * 1000L
-
-/** The Shorts feed: videos on this phone of up to three minutes, newest first. */
-fun shortsFrom(videos: List<Video>): List<Video> =
-    videos.filter { it.durationMs in 1..SHORTS_MAX_DURATION_MS }.sortedByDescending { it.dateAddedSec }
-
-/** Lets another screen (Home) open Shorts at one particular video. */
-@Singleton
-class ShortsLaunch @Inject constructor() {
-    private val _startId = MutableStateFlow<Long?>(null)
-    val startId: StateFlow<Long?> = _startId.asStateFlow()
-
-    fun request(videoId: Long) {
-        _startId.value = videoId
-    }
-
-    fun consume() {
-        _startId.value = null
-    }
-}
-
-data class ShortsUiState(
-    val status: ScreenStatus = ScreenStatus.Loading,
-    val shorts: List<Video> = emptyList(),
-    val liked: Set<Long> = emptySet(),
-)
-
-@HiltViewModel
-class ShortsViewModel @Inject constructor(
-    private val library: MediaLibraryRepository,
-    private val favorites: FavoritesRepository,
-    val launch: ShortsLaunch,
-) : ViewModel() {
-
-    val uiState: StateFlow<ShortsUiState> = combine(library.videos, favorites.favoriteVideoIdSet) { videos, liked ->
-        when (videos) {
-            LibraryState.Loading -> ShortsUiState(ScreenStatus.Loading)
-            is LibraryState.Failed -> ShortsUiState(ScreenStatus.Failed(videos.message))
-            is LibraryState.Ready -> ShortsUiState(ScreenStatus.Ready, shortsFrom(videos.data), liked)
-        }
-    }
-        .flowOn(Dispatchers.Default)
-        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000L), ShortsUiState())
-
-    fun toggleLike(videoId: Long) {
-        viewModelScope.launch { favorites.toggleVideo(videoId) }
-    }
-
-    fun refresh() = library.refresh()
-}
-
-/**
- * Shorts: a vertical feed of the short videos on this phone. Swipe up for the
- * next one, tap to pause, double-tap to like. One player is shared by all pages.
- */
-@Composable
-fun ShortsScreen(
-    onOpenInPlayer: (Video) -> Unit,
-    viewModel: ShortsViewModel = hiltViewModel(),
-) {
-    val permission = rememberPermissionGroupState(
-        permissions = MediaPermissions.video,
-        isGranted = { it.video != VideoAccess.None },
-        onResult = { granted -> if (granted) viewModel.refresh() },
-    )
-    val state by viewModel.uiState.collectAsStateWithLifecycle()
-
-    Box(
-        Modifier
-            .fillMaxSize()
-            .background(Color.Black),
-    ) {
-        val status = state.status
-        when {
-            !permission.granted -> PermissionState(
-                title = "Allow access to videos",
-                message = "Shorts plays the short videos saved on this phone. VORTEX X needs the Photos & videos permission to find them.",
-                permanentlyDenied = permission.permanentlyDenied,
-                onRequest = permission::request,
-                onOpenSettings = permission::openAppSettings,
-            )
-            status is ScreenStatus.Failed -> ErrorState("Couldn't read videos", status.message, onRetry = viewModel::refresh)
-            status == ScreenStatus.Loading -> LoadingState("Finding short videos…")
-            state.shorts.isEmpty() -> EmptyState(
-                icon = Icons.Rounded.Movie,
-                title = "No short videos yet",
-                message = "Videos of up to 3 minutes on this phone appear here. Record one or save one to this phone, then scan again.",
-                actionLabel = "Scan again",
-                onAction = viewModel::refresh,
-            )
-            else -> ShortsPager(
-                shorts = state.shorts,
-                liked = state.liked,
-                launch = viewModel.launch,
-                onToggleLike = viewModel::toggleLike,
-                onOpenInPlayer = onOpenInPlayer,
-            )
-        }
-
-        Row(
-            Modifier
-                .fillMaxWidth()
-                .background(Brush.verticalGradient(listOf(Color.Black.copy(alpha = 0.55f), Color.Transparent)))
-                .statusBarsPadding()
-                .padding(horizontal = ScreenMargin, vertical = VortexSpacing.md),
-            verticalAlignment = Alignment.CenterVertically,
-        ) {
-            VortexMark(size = 24.dp)
-            Spacer(Modifier.width(10.dp))
-            Text("Shorts", style = MaterialTheme.typography.titleLarge, color = Color.White)
-            Spacer(Modifier.weight(1f))
-            if (state.shorts.isNotEmpty()) {
-                Text(
-                    LibraryLogic.pluralize(state.shorts.size, "video"),
-                    style = MaterialTheme.typography.labelMedium,
-                    color = Color.White.copy(alpha = 0.75f),
-                )
-            }
-        }
-    }
-}
-
-@androidx.annotation.OptIn(UnstableApi::class)
-@OptIn(ExperimentalFoundationApi::class)
-@Composable
-private fun ShortsPager(
-    shorts: List<Video>,
-    liked: Set<Long>,
-    launch: ShortsLaunch,
-    onToggleLike: (Long) -> Unit,
-    onOpenInPlayer: (Video) -> Unit,
-) {
-    val context = LocalContext.current
-    val pagerState = rememberPagerState(pageCount = { shorts.size })
-    val player = remember {
-        ExoPlayer.Builder(context)
-            .setAudioAttributes(
-                AudioAttributes.Builder()
-                    .setUsage(C.USAGE_MEDIA)
-                    .setContentType(C.AUDIO_CONTENT_TYPE_MOVIE)
-                    .build(),
-                /* handleAudioFocus = */ true,
-            )
-            .setHandleAudioBecomingNoisy(true)
-            .build()
-            .apply { repeatMode = Player.REPEAT_MODE_ONE }
-    }
-    var muted by rememberSaveable { mutableStateOf(false) }
-    var userPaused by remember { mutableStateOf(false) }
-    var firstFrame by remember { mutableStateOf(false) }
-    var aspect by remember { mutableFloatStateOf(0f) }
-    var progress by remember { mutableFloatStateOf(0f) }
-
-    DisposableEffect(player) {
-        val listener = object : Player.Listener {
-            override fun onRenderedFirstFrame() {
-                firstFrame = true
-            }
-
-            override fun onVideoSizeChanged(videoSize: VideoSize) {
-                if (videoSize.width > 0 && videoSize.height > 0) {
-                    aspect = videoSize.width * videoSize.pixelWidthHeightRatio / videoSize.height
-                }
-            }
-        }
-        player.addListener(listener)
-        onDispose {
-            player.removeListener(listener)
-            player.release()
-        }
-    }
-
-    // Home can ask for one particular short.
-    val startId by launch.startId.collectAsStateWithLifecycle()
-    LaunchedEffect(startId, shorts) {
-        val id = startId ?: return@LaunchedEffect
-        val index = shorts.indexOfFirst { it.id == id }
-        if (index >= 0) pagerState.scrollToPage(index)
-        launch.consume()
-    }
-
-    val current = shorts.getOrNull(pagerState.settledPage)
-    LaunchedEffect(current?.id) {
-        val video = current ?: return@LaunchedEffect
-        firstFrame = false
-        aspect = 0f
-        progress = 0f
-        userPaused = false
-        player.setMediaItem(MediaItem.fromUri(video.contentUri))
-        player.prepare()
-        player.playWhenReady = true
-        while (true) {
-            val duration = player.duration
-            progress = if (duration > 0) (player.currentPosition.toFloat() / duration).coerceIn(0f, 1f) else 0f
-            delay(120)
-        }
-    }
-    LaunchedEffect(muted) { player.volume = if (muted) 0f else 1f }
-
-    LifecycleEventEffect(Lifecycle.Event.ON_PAUSE) { player.pause() }
-    LifecycleEventEffect(Lifecycle.Event.ON_RESUME) { if (!userPaused) player.play() }
-
-    val view = LocalView.current
-    DisposableEffect(view) {
-        view.keepScreenOn = true
-        onDispose { view.keepScreenOn = false }
-    }
-
-    VerticalPager(
-        state = pagerState,
-        modifier = Modifier.fillMaxSize(),
-        key = { index -> shorts.getOrNull(index)?.id ?: index.toLong() },
-    ) { page ->
-        val video = shorts[page]
-        val isCurrent = page == pagerState.settledPage
-        ShortPage(
-            video = video,
-            isCurrent = isCurrent,
-            player = player,
-            showVideo = isCurrent && firstFrame,
-            aspect = if (isCurrent) aspect else 0f,
-            paused = isCurrent && userPaused,
-            muted = muted,
-            liked = video.id in liked,
-            progress = if (isCurrent) progress else 0f,
-            onTogglePlay = {
-                if (player.isPlaying) {
-                    userPaused = true
-                    player.pause()
-                } else {
-                    userPaused = false
-                    player.play()
-                }
-            },
-            onToggleMute = { muted = !muted },
-            onToggleLike = { onToggleLike(video.id) },
-            onShare = { shareVideo(context, video) },
-            onOpenInPlayer = {
-                player.pause()
-                onOpenInPlayer(video)
-            },
-        )
-    }
-}
-
-@Composable
-private fun ShortPage(
-    video: Video,
-    isCurrent: Boolean,
-    player: ExoPlayer,
-    showVideo: Boolean,
-    aspect: Float,
-    paused: Boolean,
-    muted: Boolean,
-    liked: Boolean,
-    progress: Float,
-    onTogglePlay: () -> Unit,
-    onToggleMute: () -> Unit,
-    onToggleLike: () -> Unit,
-    onShare: () -> Unit,
-    onOpenInPlayer: () -> Unit,
-) {
-    val togglePlay by rememberUpdatedState(onTogglePlay)
-    val toggleLike by rememberUpdatedState(onToggleLike)
-    val isLiked by rememberUpdatedState(liked)
-    val heart = remember { Animatable(0f) }
-    val scope = rememberCoroutineScope()
-
-    Box(
-        Modifier
-            .fillMaxSize()
-            .background(Color.Black)
-            .pointerInput(video.id) {
-                detectTapGestures(
-                    onTap = { togglePlay() },
-                    onDoubleTap = {
-                        if (!isLiked) toggleLike()
-                        scope.launch {
-                            heart.snapTo(0f)
-                            heart.animateTo(1f, tween(durationMillis = 560))
-                            heart.snapTo(0f)
-                        }
-                    },
-                )
-            },
-    ) {
-        // Soft backdrop so letterboxed clips do not sit on plain black (blur needs Android 12+).
-        VideoThumbnail(
-            video,
-            Modifier
-                .fillMaxSize()
-                .blur(28.dp)
-                .alpha(0.4f),
-            cornerRadius = 0.dp,
-        )
-
-        if (isCurrent) {
-            AndroidView(
-                factory = { ctx -> TextureView(ctx).also { player.setVideoTextureView(it) } },
-                onRelease = { player.clearVideoTextureView(it) },
-                modifier = Modifier
-                    .align(Alignment.Center)
-                    .aspectRatio(if (aspect > 0f) aspect else 9f / 16f),
-            )
-        }
-
-        // Poster until the first frame is on screen.
-        AnimatedVisibility(
-            visible = !showVideo,
-            enter = fadeIn(tween(0)),
-            exit = fadeOut(tween(220)),
-            modifier = Modifier.fillMaxSize(),
-        ) {
-            VideoThumbnail(video, Modifier.fillMaxSize(), cornerRadius = 0.dp, initialsSize = 72.sp)
-        }
-
-        Box(
-            Modifier
-                .align(Alignment.BottomCenter)
-                .fillMaxWidth()
-                .height(260.dp)
-                .background(Brush.verticalGradient(listOf(Color.Transparent, Color.Black.copy(alpha = 0.8f)))),
-        )
-
-        if (paused) {
-            Box(
-                Modifier
-                    .align(Alignment.Center)
-                    .size(84.dp)
-                    .clip(CircleShape)
-                    .background(Color.Black.copy(alpha = 0.5f)),
-                contentAlignment = Alignment.Center,
-            ) {
-                Icon(Icons.Rounded.PlayArrow, contentDescription = "Paused", tint = Color.White, modifier = Modifier.size(52.dp))
-            }
-        }
-
-        Icon(
-            Icons.Rounded.Favorite,
-            contentDescription = null,
-            tint = VortexColors.Accent,
-            modifier = Modifier
-                .align(Alignment.Center)
-                .size(128.dp)
-                .graphicsLayer {
-                    val t = heart.value
-                    alpha = when {
-                        t <= 0f -> 0f
-                        t < 0.2f -> t / 0.2f
-                        else -> 1f - (t - 0.2f) / 0.8f
-                    }
-                    val s = 0.6f + 0.7f * t
-                    scaleX = s
-                    scaleY = s
-                },
-        )
-
-        Column(
-            Modifier
-                .align(Alignment.BottomEnd)
-                .padding(end = VortexSpacing.sm, bottom = 28.dp),
-            horizontalAlignment = Alignment.CenterHorizontally,
-            verticalArrangement = Arrangement.spacedBy(VortexSpacing.sm),
-        ) {
-            ShortAction(
-                icon = if (liked) Icons.Rounded.Favorite else Icons.Rounded.FavoriteBorder,
-                label = if (liked) "Liked" else "Like",
-                description = if (liked) "Remove like" else "Like",
-                tint = if (liked) VortexColors.Accent else Color.White,
-                onClick = onToggleLike,
-            )
-            ShortAction(
