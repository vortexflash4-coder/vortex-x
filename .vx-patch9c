+
+private class HubEntry(val icon: ImageVector, val title: String, val summary: String, val category: SettingsCategory?)
+
+/** The Settings hub: one row per area that has working settings. Audio Lab has its own screen. */
+private fun LazyListScope.hubItems(
+    mode: SettingsMode,
+    onOpenAudioLab: () -> Unit,
+    onOpenCategory: (SettingsCategory) -> Unit,
+) {
+    val shown = SettingsCatalog.visible(mode, "").map { it.category }.toSet()
+    val groups = listOf(
+        "Playback" to listOf(
+            HubEntry(Icons.Rounded.Equalizer, "Audio Lab", "Equalizer, bass, dynamics and output", null),
+            HubEntry(Icons.Rounded.LibraryMusic, "Music playback", "Headphones and silence", SettingsCategory.Music),
+            HubEntry(Icons.Rounded.VideoLibrary, "Video playback", "Resume, screen and picture size", SettingsCategory.Video),
+        ),
+        "Library" to listOf(
+            HubEntry(Icons.Rounded.Folder, "Library and storage", "Short clips and media scan", SettingsCategory.Library),
+        ),
+        "App" to listOf(
+            HubEntry(Icons.Rounded.Tune, "General and interface", "Detail level", SettingsCategory.General),
+            HubEntry(Icons.Rounded.Build, "Developer diagnostics", "Decoder reports and logging", SettingsCategory.Developer),
+        ),
+    )
+    item(key = "hub-profile") {
+        VortexCard(
+            modifier = Modifier
+                .padding(horizontal = VortexSpacing.lg, vertical = VortexSpacing.sm)
+                .widthIn(max = 840.dp)
+                .fillMaxWidth(),
+            contentPadding = PaddingValues(VortexSpacing.lg),
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                VortexMark(size = 40.dp)
+                Spacer(Modifier.width(VortexSpacing.md))
+                Column {
+                    Text("Your VORTEX X", style = MaterialTheme.typography.titleMedium)
+                    Text("Personal media, your way", style = MaterialTheme.typography.bodyMedium, color = VortexColors.TextSecondary)
+                }
+            }
+        }
+    }
+    groups.forEach { (title, entries) ->
+        val rows = entries.filter { it.category == null || it.category in shown }
+        if (rows.isNotEmpty()) {
+            item(key = "hub-header-$title") { SectionHeader(title) }
+            item(key = "hub-card-$title") {
+                VortexCard(
+                    modifier = Modifier
+                        .padding(horizontal = VortexSpacing.lg)
+                        .widthIn(max = 840.dp)
+                        .fillMaxWidth(),
+                    contentPadding = PaddingValues(vertical = VortexSpacing.xs),
+                ) {
+                    rows.forEachIndexed { index, entry ->
+                        if (index > 0) HorizontalDivider(color = VortexColors.Divider.copy(alpha = 0.6f))
+                        val category = entry.category
+                        HubRow(entry.icon, entry.title, entry.summary) {
+                            if (category == null) onOpenAudioLab() else onOpenCategory(category)
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun HubRow(icon: ImageVector, title: String, summary: String, onClick: () -> Unit) {
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .clickable(role = Role.Button, onClick = onClick)
+            .padding(horizontal = VortexSpacing.lg, vertical = VortexSpacing.md),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Icon(icon, contentDescription = null, tint = VortexColors.TextSecondary, modifier = Modifier.size(24.dp))
+        Spacer(Modifier.width(VortexSpacing.md))
+        Column(Modifier.weight(1f)) {
+            Text(title, style = MaterialTheme.typography.titleSmall)
+            Text(summary, style = MaterialTheme.typography.bodySmall, color = VortexColors.TextSecondary)
+        }
+        Icon(Icons.AutoMirrored.Rounded.KeyboardArrowRight, contentDescription = null, tint = VortexColors.TextSecondary)
+    }
+}
